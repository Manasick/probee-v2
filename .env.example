# Public Supabase project configuration.
# Replace these placeholders only in your local .env.local file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public application URL used for Supabase Auth email redirects.
# Production example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email provider.
# Leave EMAIL_PROVIDER empty until a provider is selected/configured.
# Supported adapter in STEP 15: resend
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_API_KEY=

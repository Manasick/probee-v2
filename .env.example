# Public Supabase project configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public application URL used for Supabase Auth email redirects.
# Production example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only transactional email configuration.
# Keep EMAIL_API_KEY out of NEXT_PUBLIC_* variables.
# Keep EMAIL_PROVIDER=none until a real provider is configured.
EMAIL_PROVIDER=none
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_API_KEY=
